# Values an environment supplies to compose.yaml's one-shot jobs.
# Keep the real file outside Git (mode 600).

# The environment's Echo network (it must reach MySQL) and MySQL's hostname
# as seen from it — the same host the echo/DB_HOST row names.
ECHO_NETWORK=
ECHO_DB_HOST=
# ECHO_DB_NAME=echo_db

# Account the jobs run as (migrations and user management): echo_admin, created
# by AidaPlatformDB/install.sh database with all rights on echo_db and CREATE
# USER; the password is the echo/MYSQL_ADMIN_PASSWORD row. Root works too but
# should never leave the database host.
MYSQL_ADMIN_USER=echo_admin
MYSQL_ADMIN_PASSWORD=

# The DB_PASSWORD values this environment gives EchoWeb and EchoService.
# ECHO_WEB_DB_USER=echo_web
ECHO_WEB_DB_PASSWORD=
# ECHO_SERVICE_DB_USER=echo_service
ECHO_SERVICE_DB_PASSWORD=

# read-write: EchoService may execute every procedure (sending, saving).
# read-only:  only the *_GET procedures; nothing can be sent or changed.
ECHO_DB_ACCESS=read-write

# compose.dev.yaml only: root password of the throwaway local MySQL.
# MYSQL_ROOT_PASSWORD=devroot
