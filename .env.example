# Copy to .env (mode 600) — install.sh database writes it. Only what
# compose.yaml cannot know by itself; every application setting is a
# PlatformConfig row.
NOCODB_BASE_URL=https://nocodb.X.TLD
MYSQL_ROOT_PASSWORD=
NC_AUTH_JWT_SECRET=
# Where MySQL listens. Loopback serves applications on this host; a platform
# whose applications run elsewhere publishes on an address they can reach.
# MYSQL_PUBLISH=127.0.0.1:3306
# Where MySQL's data directory and NocoDB's store live on this host
# (DATA_DIR/mysql, DATA_DIR/nocodb). Back this path up.
# DATA_DIR=/var/lib/aidaplatformdb
# Container hostnames, shown in logs; the defaults are fine.
# MYSQL_HOSTNAME=platform-mysql
# NOCODB_HOSTNAME=platform-nocodb
# TZ=America/Los_Angeles

# Installer-only rerun defaults, written by install.sh. Not application settings.
# The installer token is hidden in prompts/output; Enter keeps its current value.
# NOCODB_INSTALLER_TOKEN=
# INSTALL_PARENT_DOMAIN=X.TLD
# INSTALL_ENVIRONMENT_NAME=dev
